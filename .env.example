# sounds-great-ai backend configuration
# Copy to .env and fill in values: cp .env.example .env

# HTTP server port
PORT=8080

# Model configuration (optional — server starts without these)
MODEL_TYPE=
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# CLI adapter path (for CLI-based model adapters)
MODEL_CLI_PATH=

# Skill files directory
SKILL_DIR=internal/agent/skills

# Workspace directory for code search + RAG persistence (default: cwd)
WORKSPACE_DIR=

# Breed JSON config directory
BREEDS_DIR=packs/default/breeds

# Embedding model
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# RAG store backend: memory | sqlite | eino
RAG_STORE_BACKEND=memory
